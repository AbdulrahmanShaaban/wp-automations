{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1200px",
      "wideSize": "1280px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "bg", "name": "Background", "color": "#FAF8F4" },
        { "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
        { "slug": "text", "name": "Text", "color": "#1B1A17" },
        { "slug": "muted", "name": "Muted", "color": "#5F5A52" },
        { "slug": "primary", "name": "Primary", "color": "#0B6B57" },
        { "slug": "on-primary", "name": "On Primary", "color": "#FFFFFF" },
        { "slug": "accent", "name": "Accent", "color": "#B45309" },
        { "slug": "border", "name": "Border", "color": "#E6E1D8" },
        { "slug": "primary-soft", "name": "Primary Soft", "color": "#E4F1EC" },
        { "slug": "sale", "name": "Sale", "color": "#9A3412" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Cairo",
          "fontFamily": "\"Cairo\", \"Inter\", system-ui, -apple-system, \"Segoe UI\", Tahoma, sans-serif"
        },
        {
          "slug": "latin",
          "name": "Inter",
          "fontFamily": "\"Inter\", system-ui, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "sm", "name": "Small", "size": "0.875rem", "fluid": false },
        { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
        { "slug": "body", "name": "Body", "size": "1.0625rem", "fluid": false },
        { "slug": "lg", "name": "Large", "size": "1.125rem", "fluid": false },
        { "slug": "h3", "name": "H3", "size": "clamp(1.375rem, 1.15rem + 0.8vw, 1.625rem)", "fluid": false },
        { "slug": "h2", "name": "H2", "size": "clamp(1.75rem, 1.3rem + 1.8vw, 2.5rem)", "fluid": false },
        { "slug": "hero", "name": "Hero H1", "size": "clamp(2.4rem, 1.6rem + 3.4vw, 3.75rem)", "fluid": false }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "4", "size": "0.25rem" },
        { "slug": "20", "name": "8", "size": "0.5rem" },
        { "slug": "30", "name": "12", "size": "0.75rem" },
        { "slug": "40", "name": "16", "size": "1rem" },
        { "slug": "60", "name": "24", "size": "1.5rem" },
        { "slug": "80", "name": "32", "size": "2rem" },
        { "slug": "120", "name": "48", "size": "3rem" },
        { "slug": "160", "name": "64", "size": "4rem" },
        { "slug": "240", "name": "96", "size": "6rem" },
        { "slug": "300", "name": "120", "size": "7.5rem" }
      ]
    },
    "border": {
      "color": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--body)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "20px",
        "right": "20px"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "800"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--text)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--on-primary)"
        },
        "typography": {
          "fontWeight": "700"
        },
        "border": {
          "radius": "999px"
        }
      }
    }
  }
}
