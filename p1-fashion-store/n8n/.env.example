# Nilad Order Ops Suite — environment variables (copy into your n8n env / .env file).
# Secrets are OWNER-PROVIDED. Never commit real values, never paste them in chat.

# --- Webhook verification (F1/F2) ---
# Must equal the WooCommerce webhook secret (Store → Settings → Advanced → Webhooks).
WOO_WEBHOOK_SECRET=replace-with-wc-webhook-secret

# --- Telegram alerts (F1/F3/F4/F5/F7 + Error Workflow) ---
# Create via @BotFather (ASSETS_TODO #4), then /start the bot and get the chat id.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
TELEGRAM_CHAT_ID=replace-with-chat-id

# --- Google Sheets order log (F1) ---
# Sheet shared with the n8n Google OAuth2 credential.
# GOOGLE_SHEET_ID: the /d/<ID>/ part of the sheet URL.
GOOGLE_SHEET_ID=replace-with-sheet-id
# GOOGLE_SHEET_GID: the #gid=<N> value of the URL (tab selected by ID — preferred,
# because a tab's *name* can be Arabic/localized). If you would rather pick the tab
# by name in the n8n UI, set the node's Sheet field to "By Name" and use the tab name.
GOOGLE_SHEET_GID=0
GOOGLE_SHEET_TAB=Sheet1
# SHEETS_ENABLED: set to true ONLY after the Google credential is connected in the
# n8n UI. While it is false/unset, F1 skips the Sheets node (Telegram still fires)
# so a missing credential can never mark a good order alert as failed.
SHEETS_ENABLED=false

# --- WooCommerce REST (F3/F5/F6 fetch orders, F4 fetch products) ---
# Advanced → REST API. Query-string auth is demo-acceptable over localhost;
# production must use HTTPS (see runbooks.md).
STORE_URL=http://host.docker.internal:8888
WC_API_KEY=ck_replace
WC_API_SECRET=cs_replace

# --- Tunables ---
PENDING_HOURS=48
LOW_STOCK_QTY=5
REVIEW_AFTER_DAYS=5

# --- n8n runtime (must be set when starting n8n) ---
NODE_FUNCTION_ALLOW_BUILTIN=crypto
GENERIC_TIMEZONE=Africa/Cairo
# SMTP is configured as an n8n Credential (UI), not an env var — used by F2/F3/F6.
