{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "760px",
      "wideSize": "1120px"
    },
    "color": {
      "custom": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "bg", "name": "Canvas", "color": "#F7F8FC" },
        { "slug": "surface", "name": "Surface", "color": "#FFFFFF" },
        { "slug": "text", "name": "Text", "color": "#12132B" },
        { "slug": "muted", "name": "Muted", "color": "#555878" },
        { "slug": "primary", "name": "Primary", "color": "#2F4BD8" },
        { "slug": "on-primary", "name": "On Primary", "color": "#FFFFFF" },
        { "slug": "accent", "name": "Accent", "color": "#A3231B" },
        { "slug": "border", "name": "Border", "color": "#E1E2EF" },
        { "slug": "primary-soft", "name": "Primary Soft", "color": "#E6EAFB" },
        { "slug": "success", "name": "Success", "color": "#15803D" },
        { "slug": "danger", "name": "Danger", "color": "#B91C1C" }
      ]
    },
    "typography": {
      "fluid": true,
      "defaultFontSizes": false,
      "fontFamilies": [
        {
          "slug": "body",
          "name": "Alexandria",
          "fontFamily": "\"Alexandria\", system-ui, -apple-system, \"Segoe UI\", Tahoma, sans-serif"
        }
      ],
      "fontSizes": [
        { "slug": "sm", "name": "Small", "size": "0.875rem", "fluid": false },
        { "slug": "base", "name": "Base", "size": "1rem", "fluid": false },
        { "slug": "lg", "name": "Large", "size": "1.25rem", "fluid": false },
        { "slug": "xl", "name": "XL", "size": "1.5rem", "fluid": false },
        { "slug": "h3", "name": "H3", "size": "clamp(1.375rem, 1.15rem + 0.8vw, 1.625rem)", "fluid": false },
        { "slug": "h2", "name": "H2", "size": "clamp(1.75rem, 1.2rem + 2vw, 2.5rem)", "fluid": false },
        { "slug": "hero", "name": "Hero H1", "size": "clamp(2.5rem, 1rem + 7vw, 5.25rem)", "fluid": false }
      ]
    },
    "spacing": {
      "units": ["px", "rem", "em", "%", "vw"],
      "defaultSpacingSizes": false,
      "spacingSizes": [
        { "slug": "10", "name": "4", "size": "0.25rem" },
        { "slug": "20", "name": "8", "size": "0.5rem" },
        { "slug": "30", "name": "12", "size": "0.75rem" },
        { "slug": "40", "name": "16", "size": "1rem" },
        { "slug": "60", "name": "24", "size": "1.5rem" },
        { "slug": "80", "name": "32", "size": "2rem" },
        { "slug": "120", "name": "48", "size": "3rem" },
        { "slug": "160", "name": "64", "size": "4rem" },
        { "slug": "240", "name": "96", "size": "6rem" }
      ]
    },
    "border": {
      "color": true,
      "style": true,
      "width": true
    },
    "custom": {
      "lineHeight": true
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--bg)",
      "text": "var(--wp--preset--color--text)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.7"
    },
    "spacing": {
      "blockGap": "1.5rem",
      "padding": {
        "left": "0",
        "right": "0"
      }
    },
    "elements": {
      "heading": {
        "typography": {
          "fontWeight": "800"
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--text)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--on-primary)"
        },
        "typography": {
          "fontWeight": "600"
        },
        "border": {
          "radius": "14px"
        }
      }
    }
  }
}
